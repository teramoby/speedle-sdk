{
  "$schema": "../schema.json",
  "id": "retry-burst-429-exceeds-deadline",
  "description": "Burst 429 rate_limited with Cloud's real Retry-After: 60 does not fit the 5 s default deadline. The SDK raises RateLimitedError at once without sleeping.",
  "backend": "speedle-cloud",
  "config": {
    "auth": {
      "type": "bearer",
      "token": "spdl_018bcfe5-6800-7000-8000-000000000001_0000000000000000000000000000000000000000000"
    }
  },
  "jitterFraction": 1,
  "call": {
    "method": "isAllowed",
    "subject": "alice",
    "action": "get",
    "resource": "/books/123"
  },
  "expect": {
    "error": {
      "type": "RateLimitedError",
      "status": 429,
      "code": "rate_limited",
      "retryAfterSeconds": 60,
      "quotaDailyRemaining": null
    },
    "delaysMs": []
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/authz-check/v1/is-allowed",
        "headers": {
          "Authorization": "Bearer spdl_018bcfe5-6800-7000-8000-000000000001_0000000000000000000000000000000000000000000",
          "Content-Type": {
            "pattern": "^application/json(;.*)?$"
          },
          "User-Agent": {
            "pattern": "^speedle-sdk-[a-z]+/[0-9]+\\.[0-9]+\\.[0-9]+.*$"
          }
        },
        "body": {
          "subject": {
            "principals": [
              {
                "type": "user",
                "name": "alice"
              }
            ]
          },
          "resource": "/books/123",
          "action": "get"
        }
      },
      "response": {
        "status": 429,
        "headers": {
          "Cache-Control": "no-store",
          "X-RateLimit-Limit": "600",
          "Retry-After": "60"
        },
        "body": {
          "error": "rate_limited"
        }
      }
    }
  ],
  "events": [
    {
      "type": "attempt",
      "attempt": 1,
      "status": 429,
      "errorType": "RateLimitedError"
    },
    {
      "type": "giveUp",
      "attempts": 1,
      "reason": "retry_after_exceeds_deadline",
      "errorType": "RateLimitedError"
    }
  ]
}
