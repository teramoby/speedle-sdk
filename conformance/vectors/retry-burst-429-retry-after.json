{
  "$schema": "../schema.json",
  "id": "retry-burst-429-retry-after",
  "description": "Burst 429 rate_limited with Retry-After: 1 fits the 5 s default deadline. The SDK waits max(backoff, Retry-After) = 1000 ms and the retry is allowed.",
  "backend": "speedle-cloud",
  "config": {
    "auth": {
      "type": "bearer",
      "token": "spdl_018bcfe5-6800-7000-8000-000000000001_0000000000000000000000000000000000000000000"
    }
  },
  "jitterFraction": 1,
  "call": {
    "method": "isAllowed",
    "subject": "alice",
    "action": "get",
    "resource": "/books/123"
  },
  "expect": {
    "result": true,
    "delaysMs": [
      1000
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/authz-check/v1/is-allowed",
        "headers": {
          "Authorization": "Bearer spdl_018bcfe5-6800-7000-8000-000000000001_0000000000000000000000000000000000000000000",
          "Content-Type": {
            "pattern": "^application/json(;.*)?$"
          },
          "User-Agent": {
            "pattern": "^speedle-sdk-[a-z]+/[0-9]+\\.[0-9]+\\.[0-9]+.*$"
          }
        },
        "body": {
          "subject": {
            "principals": [
              {
                "type": "user",
                "name": "alice"
              }
            ]
          },
          "resource": "/books/123",
          "action": "get"
        }
      },
      "response": {
        "status": 429,
        "headers": {
          "Cache-Control": "no-store",
          "X-RateLimit-Limit": "600",
          "Retry-After": "1"
        },
        "body": {
          "error": "rate_limited"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/authz-check/v1/is-allowed",
        "headers": {
          "Authorization": "Bearer spdl_018bcfe5-6800-7000-8000-000000000001_0000000000000000000000000000000000000000000",
          "Content-Type": {
            "pattern": "^application/json(;.*)?$"
          },
          "User-Agent": {
            "pattern": "^speedle-sdk-[a-z]+/[0-9]+\\.[0-9]+\\.[0-9]+.*$"
          }
        },
        "body": {
          "subject": {
            "principals": [
              {
                "type": "user",
                "name": "alice"
              }
            ]
          },
          "resource": "/books/123",
          "action": "get"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "X-RateLimit-Limit": "600",
          "X-Quota-Daily-Remaining": "9990"
        },
        "body": {
          "allowed": true,
          "reason": 0
        }
      }
    }
  ],
  "events": [
    {
      "type": "attempt",
      "attempt": 1,
      "status": 429,
      "errorType": "RateLimitedError"
    },
    {
      "type": "retry",
      "attempt": 2,
      "delayMs": 1000,
      "errorType": "RateLimitedError"
    },
    {
      "type": "attempt",
      "attempt": 2,
      "status": 200,
      "errorType": null
    }
  ]
}
