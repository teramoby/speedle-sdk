{
  "$schema": "../schema.json",
  "id": "cloud-allowed",
  "description": "Speedle Cloud allows the request; check returns the decision and the remaining daily quota.",
  "backend": "speedle-cloud",
  "config": {
    "auth": {
      "type": "bearer",
      "token": "spdl_018bcfe5-6800-7000-8000-000000000001_0000000000000000000000000000000000000000000"
    }
  },
  "call": {
    "method": "check",
    "subject": "alice",
    "action": "get",
    "resource": "/books/123",
    "attributes": {
      "team": "engineering",
      "nested": [
        null,
        {
          "enabled": true
        }
      ]
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/authz-check/v1/is-allowed",
        "headers": {
          "Authorization": "Bearer spdl_018bcfe5-6800-7000-8000-000000000001_0000000000000000000000000000000000000000000",
          "Content-Type": {
            "pattern": "^application/json(;.*)?$"
          },
          "User-Agent": {
            "pattern": "^speedle-sdk-[a-z]+/[0-9]+\\.[0-9]+\\.[0-9]+.*$"
          }
        },
        "body": {
          "subject": {
            "principals": [
              {
                "type": "user",
                "name": "alice"
              }
            ]
          },
          "resource": "/books/123",
          "action": "get",
          "attributes": {
            "team": "engineering",
            "nested": [
              null,
              {
                "enabled": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "X-RateLimit-Limit": "600",
          "X-Quota-Daily-Remaining": "9999"
        },
        "body": {
          "allowed": true,
          "reason": 0
        }
      }
    }
  ],
  "expect": {
    "decision": {
      "allowed": true,
      "reason": 0,
      "errorMessage": null,
      "quotaDailyRemaining": 9999
    }
  }
}
