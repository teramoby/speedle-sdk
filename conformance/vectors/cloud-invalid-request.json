{
  "$schema": "../schema.json",
  "id": "cloud-invalid-request",
  "description": "Speedle Cloud rejects the request with 400 invalid_request. The call was charged, so the quota header is present. No retry.",
  "backend": "speedle-cloud",
  "config": {
    "auth": {
      "type": "bearer",
      "token": "spdl_018bcfe5-6800-7000-8000-000000000001_0000000000000000000000000000000000000000000"
    }
  },
  "call": {
    "method": "isAllowed",
    "subject": "alice",
    "action": "get",
    "resource": "/books/123"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/authz-check/v1/is-allowed",
        "headers": {
          "Authorization": "Bearer spdl_018bcfe5-6800-7000-8000-000000000001_0000000000000000000000000000000000000000000",
          "Content-Type": {
            "pattern": "^application/json(;.*)?$"
          },
          "User-Agent": {
            "pattern": "^speedle-sdk-[a-z]+/[0-9]+\\.[0-9]+\\.[0-9]+.*$"
          }
        },
        "body": {
          "subject": {
            "principals": [
              {
                "type": "user",
                "name": "alice"
              }
            ]
          },
          "resource": "/books/123",
          "action": "get"
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "Cache-Control": "no-store",
          "X-RateLimit-Limit": "600",
          "X-Quota-Daily-Remaining": "9998"
        },
        "body": {
          "error": "invalid_request"
        }
      }
    }
  ],
  "expect": {
    "error": {
      "type": "InvalidRequestError",
      "status": 400,
      "code": "invalid_request",
      "quotaDailyRemaining": 9998
    }
  }
}
