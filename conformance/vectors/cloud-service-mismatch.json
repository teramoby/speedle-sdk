{
  "$schema": "../schema.json",
  "id": "cloud-service-mismatch",
  "description": "The call overrides serviceName with a service other than the token's. Speedle Cloud returns 403 service_mismatch: ForbiddenError, charged, not retried.",
  "backend": "speedle-cloud",
  "config": {
    "auth": {
      "type": "bearer",
      "token": "spdl_018bcfe5-6800-7000-8000-000000000001_0000000000000000000000000000000000000000000"
    },
    "serviceName": "books"
  },
  "call": {
    "method": "isAllowed",
    "subject": "alice",
    "action": "get",
    "resource": "/books/123",
    "serviceName": "orders"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/authz-check/v1/is-allowed",
        "headers": {
          "Authorization": "Bearer spdl_018bcfe5-6800-7000-8000-000000000001_0000000000000000000000000000000000000000000",
          "Content-Type": {
            "pattern": "^application/json(;.*)?$"
          },
          "User-Agent": {
            "pattern": "^speedle-sdk-[a-z]+/[0-9]+\\.[0-9]+\\.[0-9]+.*$"
          }
        },
        "body": {
          "subject": {
            "principals": [
              {
                "type": "user",
                "name": "alice"
              }
            ]
          },
          "serviceName": "orders",
          "resource": "/books/123",
          "action": "get"
        }
      },
      "response": {
        "status": 403,
        "headers": {
          "Cache-Control": "no-store",
          "X-RateLimit-Limit": "600",
          "X-Quota-Daily-Remaining": "9998"
        },
        "body": {
          "error": "service_mismatch"
        }
      }
    }
  ],
  "expect": {
    "error": {
      "type": "ForbiddenError",
      "status": 403,
      "code": "service_mismatch",
      "quotaDailyRemaining": 9998
    },
    "delaysMs": []
  }
}
